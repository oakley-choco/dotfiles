# This file is shared between bash and zsh
# The example @see https://github.com/paulirish/dotfiles/blob/main/.exports#L1
# The solution @see https://stackoverflow.com/a/26020688


# The zsh environment variables
export ZSH=$HOME/.oh-my-zsh
export ZSH_CUSTOM=$ZSH/custom
export DOTFILES_PATH=$HOME/.dotfiles


# The Homebrew prefix
# 新機器一律安裝在官方位置 /opt/homebrew（bootstrap-basic 會用官方安裝程式）。
# 舊機器若還留著自訂 prefix ($DOTFILES_PATH/.homebrew) 就繼續沿用，避免既有套件失效。
if [[ -x "$DOTFILES_PATH/.homebrew/bin/brew" ]]; then
    export HOMEBREW_PREFIX="$DOTFILES_PATH/.homebrew"
else
    export HOMEBREW_PREFIX="/opt/homebrew"
fi
export HOMEBREW_CELLAR="$HOMEBREW_PREFIX/Cellar"
export HOMEBREW_REPOSITORY="$HOMEBREW_PREFIX"


# Add some executable binaries path to $PATH
export PATH=$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$DOTFILES_PATH/.bin:$HOME/bin:/usr/local/bin:$PATH


# You may need to manually set your language environment
export LC_ALL="en_US.UTF-8"
export LANG="en_US.UTF-8"

# Disable Homebrew analytics
export HOMEBREW_NO_ANALYTICS=1

# For AWS CLI Pager
export AWS_PAGER=""
