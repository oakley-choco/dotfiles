#!/usr/bin/env zsh
set -eo pipefail

# 關閉 Spaceship 主題非同步機制，防止 prompt hook 傳回 exit code 1
export SPACESHIP_PROMPT_ASYNC=false
export SPACESHIP_ASYNC=false

# 載入基礎設定與函式 (避開 oh-my-zsh 在 set -e 下的潛在問題)
set +e
source $HOME/.dotfiles/configs/.zshrc 2>/dev/null
set -e

# 備用 log 函式
type info &>/dev/null || info() { echo "[INFO] $*"; }
type success &>/dev/null || success() { echo "[SUCCESS] $*"; }
type warning &>/dev/null || warning() { echo "[WARNING] $*"; }

# 確保 DOTFILES_PATH 有預設值
DOTFILES_PATH="${DOTFILES_PATH:-$HOME/.dotfiles}"

info "Start to install Homebrew packages from Brewfile..."

# 執行 brew bundle install
# 註：若希望即使有單一套件失敗也繼續執行後續動作，可以用 set +e ... set -e 包裹
if brew bundle install --no-upgrade --file="$DOTFILES_PATH/Brewfile"; then
    success "Install homebrew packages successful."
else
    warning "Some Homebrew packages failed to install. Please check the logs above."
    # 若希望此腳本依然通過 Make，可以在這裡 exit 0；若要嚴格檢查請保留 exit 1
    exit 1
fi

exit 0
