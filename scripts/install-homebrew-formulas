#!/usr/bin/env zsh
# 不能用 set -u：oh-my-zsh 內部會引用未設定的變數
set -eo pipefail

# Initial settings
# oh-my-zsh 的 plugin 補完在非互動 shell 下可能回傳非 0，
# 會被 set -e 當成失敗，所以只在 source 期間關掉 errexit。
set +e
source $HOME/.dotfiles/configs/.zshrc
set -e

# 套件清單改由 Brewfile 維護，重新產生快照：
#   brew bundle dump --force --no-vscode --file="$DOTFILES_PATH/Brewfile"
#
# --no-upgrade: 只安裝缺少的項目，不順手升級既有套件
brew bundle install --no-upgrade --file="$DOTFILES_PATH/Brewfile"

success "Install homebrew packages successful."
exit 0
